  "theorem2_spectral_thresholds": {
    "target_definition": "1-gram residual target v_k^{res} = v_k^{bigram} - v_{word(k)}, so R_prune = E_top + E_tail is exact 1-gram fallback residual risk.",
    "c_lo_formula": "r*sigma_xi2/(E_top*d)",
    "c_hi_formula": "sigma_xi2*(d - r)/(E_tail*d)",
    "ratio_c_hi_over_c_lo": "E_top*(d - r)/(E_tail*r)",
    "existence_condition_c_lo_lt_c_hi": "eta_r = E_top / (E_top + E_tail) > r / d",
    "prediction_band_r_eq_d_over_4": {
      "eta=0.60": 4.5,
      "eta=0.65": 5.57,
      "eta=0.70": 7.0,
      "eta=0.75": 9.0,
      "eta=0.80": 12.0,
      "eta=0.85": 17.0
    },
    "status_note": "Given a noise-debiased estimate of eta_r (e.g., split-half cross-covariance on ultra-high-count full-rank keys), the ratio c_hi/c_lo has no additional free parameters. Empirical architecture thresholds 10/100 (10x) were chosen prior to this formula and are retrospectively consistent with eta_{d/4} in [0.65, 0.80] (band [5.57x, 12.00x], 9.00x at eta=0.75)."
  },
